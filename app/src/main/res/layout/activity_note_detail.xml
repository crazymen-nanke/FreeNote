<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- 阅读页头部：返回 / 编辑 / 更多 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/screen_padding"
        android:paddingTop="12dp"
        android:paddingRight="@dimen/screen_padding">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.FreeNote.IconButton"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_back"
            android:tint="@color/ink" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnEdit"
            style="@style/Widget.FreeNote.IconButton"
            android:contentDescription="@string/detail_edit"
            android:src="@drawable/ic_pen"
            android:tint="@color/primary" />

        <ImageButton
            android:id="@+id/btnMore"
            style="@style/Widget.FreeNote.IconButton"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_icon_btn_soft"
            android:contentDescription="@string/detail_more"
            android:src="@drawable/ic_more"
            android:tint="@color/text_secondary" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="22dp"
            android:paddingTop="10dp"
            android:paddingRight="22dp"
            android:paddingBottom="36dp">

            <TextView
                android:id="@+id/tvDetailDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:textAppearance="@style/TextAppearance.FreeNote.Meta"
                tools:text="10月22日 · 星期四" />

            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="serif"
                android:letterSpacing="0.01"
                android:lineSpacingExtra="4sp"
                android:textColor="@color/ink"
                android:textSize="25sp"
                android:textStyle="bold"
                tools:text="桂花开了" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDetailTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:textAppearance="@style/TextAppearance.FreeNote.Caption"
                    tools:text="21:12" />

                <View
                    android:layout_width="3dp"
                    android:layout_height="3dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/bg_week_today"
                    android:backgroundTint="@color/stroke" />

                <TextView
                    android:id="@+id/tvDetailWords"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.FreeNote.Caption"
                    tools:text="268 字" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chipRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/tvDetailBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="serif"
                android:lineSpacingExtra="11sp"
                android:textColor="@color/ink_body"
                android:textIsSelectable="true"
                android:textSize="16sp"
                tools:text="风一过，整条街都是甜的。" />

            <TextView
                android:id="@+id/tvPhotoCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textAppearance="@style/TextAppearance.FreeNote.Caption"
                android:visibility="gone"
                tools:text="共 3 张 · 点开可放大"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/photoList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="26dp"
                android:background="@color/divider" />

            <TextView
                android:id="@+id/tvDetailSign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="serif"
                android:gravity="end"
                android:letterSpacing="0.04"
                android:text="@string/detail_sign"
                android:textColor="@color/text_ghost"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
